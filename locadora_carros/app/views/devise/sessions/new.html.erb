<div class="row" style="margin-top: 50px;">
  <div class="col-md-4 col-md-offset-4 col-sm-6 col-sm-offset-3">
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title" style="font-weight: bold; font-size: 20px;">Acessar o Sistema</h3>
      </div>
      <div class="panel-body">

        <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { role: "form" }) do |f| %>

          <div class="form-group">
            <%= f.label :email, "E-mail" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", placeholder: "Digite seu e-mail" %>
          </div>

          <div class="form-group">
            <%= f.label :password, "Senha" %>
            <%= f.password_field :password, autocomplete: "current-password", class: "form-control", placeholder: "Digite sua senha" %>
          </div>

          <% if devise_mapping.rememberable? %>
            <div class="checkbox">
              <label>
                <%= f.check_box :remember_me %> Lembrar-me neste computador
              </label>
            </div>
          <% end %>

          <div class="actions">
            <%= f.submit "Entrar", class: "btn btn-primary btn-block" %>
          </div>
        <% end %>

        <hr>

        <div class="text-center">
          <%= link_to "Criar uma Conta", new_registration_path(resource_name) %><br />
          <%= link_to "Esqueceu sua senha?", new_password_path(resource_name) %>
        </div>

      </div>
    </div>
  </div>
</div>
<div class="container">

  <div class="jumbotron text-center" style="background-color: #f8f9fa; border-radius: 10px; margin-top: 20px;">
    <h1>Locadora de Carros</h1>
    <p>Sistema de gerenciamento.</p>
    <hr>
  </div>





<nav class="navbar navbar-expand-lg navbar-light mb-4" style="background-color: #e9ecef; border-radius: 5px; border: 1px solid #ddd;">
  <div class="container-fluid">
    
    <a class="navbar-brand" href="/" style="font-weight: bold;">Sistema de Locação</a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarLocadora" aria-controls="navbarLocadora" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarLocadora">
      <ul class="navbar-nav ms-auto"> 
        
        <li class="nav-item">
          <%= link_to 'Carros', carros_path, class: 'nav-link', style: 'border: 1px solid #ced4da; border-radius: 5px; margin-left: 10px;' %>
        </li>
        
        <li class="nav-item">
          <%= link_to 'Locatários', locatarios_path, class: 'nav-link', style: 'border: 1px solid #ced4da; border-radius: 5px; margin-left: 10px;' %>
        </li>
        
        <li class="nav-item">
          <%= link_to 'Empréstimos', emprestimos_path, class: 'nav-link', style: 'border: 1px solid #ced4da; border-radius: 5px; margin-left: 10px;' %>
        </li>
        
        <li class="nav-item">
          <%= link_to 'Adicionar Empréstimo', new_emprestimo_path, class: 'nav-link text-info', style: 'border: 1px solid #ced4da; border-radius: 5px; margin-left: 10px;' %>
        </li>

      </ul>
    </div>
    
  </div>
</nav>
<div class="container text-center mt-4">
  <%= image_tag 'imgfundo.png', class: 'img-fluid rounded shadow-sm', alt: 'Imagem de um carro alugado' %>
</div>





   
    
    <div class="jumbotron d-flex flex-column align-items-center justify-content-center p-3 mx-auto" style="background-color: #f8f9fa; border-radius: 10px; border: 1px solid #ddd; max-width: 400px;">
      
      <p class="mb-3" style="font-size: 16px;">
        Logado como: <strong><%= current_user.email %></strong>
      </p>

      <%= button_to 'Sair do Sistema', destroy_user_session_path, method: :delete, class: 'btn btn-danger btn-sm' %>
      
    </div>

  </div>

</div> 

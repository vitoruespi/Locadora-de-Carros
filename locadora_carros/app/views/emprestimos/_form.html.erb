<%= form_for @emprestimo, :html => { :class => "emprestimo" } do |f| %>

  <% if @emprestimo.errors.any? %>
    <div class="alert alert-danger">
      <h5 class="alert-heading"><%= pluralize(@emprestimo.errors.count, "error") %> prohibited this emprestimo from being saved:</h5>
      <hr>
      <ul class="mb-0">
      <% @emprestimo.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :locatario_id, :class => 'form-label' %>
    <%= f.text_field :locatario_id, :class => 'form-control' %>
    <%=f.error_span(:locatario_id) %>
  </div>
  <div class="mb-3">
    <%= f.label :carro_id, :class => 'form-label' %>
    <%= f.text_field :carro_id, :class => 'form-control' %>
    <%=f.error_span(:carro_id) %>
  </div>
  <div class="mb-3">
    <%= f.label :data_inicio, :class => 'form-label' %>
    <%= f.text_field :data_inicio, :class => 'form-control' %>
    <%=f.error_span(:data_inicio) %>
  </div>
  <div class="mb-3">
    <%= f.label :data_fim, :class => 'form-label' %>
    <%= f.text_field :data_fim, :class => 'form-control' %>
    <%=f.error_span(:data_fim) %>
  </div>
  <div class="mb-3">
    <%= f.label :valor_total, :class => 'form-label' %>
    <%= f.text_field :valor_total, :class => 'form-control' %>
    <%=f.error_span(:valor_total) %>
  </div>

  <div class="mb-3">
    <%= f.submit nil, :class => 'btn btn-primary' %>
    <%= link_to t('.cancel', :default => t("helpers.links.cancel")),
              emprestimos_path, :class => 'btn btn-secondary' %>
  </div>

<% end %>

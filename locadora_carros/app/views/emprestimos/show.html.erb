<%- model_class = Emprestimo -%>
<div class="page-header">
  <h1><%=t '.title', :default => model_class.model_name.human.titleize %></h1>
</div>

<dl class="row">
  <dt class="col-sm-2"><%= model_class.human_attribute_name(:locatario_id) %>:</dt>
  <dd class="col-sm-10"><%= @emprestimo.locatario_id %></dd>
  <dt class="col-sm-2"><%= model_class.human_attribute_name(:carro_id) %>:</dt>
  <dd class="col-sm-10"><%= @emprestimo.carro_id %></dd>
  <dt class="col-sm-2"><%= model_class.human_attribute_name(:data_inicio) %>:</dt>
  <dd class="col-sm-10"><%= @emprestimo.data_inicio %></dd>
  <dt class="col-sm-2"><%= model_class.human_attribute_name(:data_fim) %>:</dt>
  <dd class="col-sm-10"><%= @emprestimo.data_fim %></dd>
  <dt class="col-sm-2"><%= model_class.human_attribute_name(:valor_total) %>:</dt>
  <dd class="col-sm-10"><%= @emprestimo.valor_total %></dd>
</dl>

<%= link_to t('.back', :default => t("helpers.links.back")),
              emprestimos_path, :class => 'btn btn-secondary' %>
<%= link_to t('.edit', :default => t("helpers.links.edit")),
              edit_emprestimo_path(@emprestimo), :class => 'btn btn-secondary' %>
<%= link_to t('.destroy', :default => t("helpers.links.destroy")),
              emprestimo_path(@emprestimo),
              :method => 'delete',
              :data => { :confirm => t('.confirm', :default => t("helpers.links.confirm", :default => 'Are you sure?')) },
              :class => 'btn btn-danger' %>

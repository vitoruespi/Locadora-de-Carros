<div class="page-header">
  <h1>Empréstimos Realizados</h1>
</div>
<div class="table-responsive shadow-sm" style="border-radius: 8px; overflow: hidden; border: 1px solid #ccc;">
  <table class="table table-striped table-bordered table-hover align-middle mb-0" style="background-color: #fafafa; border-color: #d6d6d6;">
    
    <thead class="table-dark">
      <tr>
        <th class="text-center">ID</th>
        <th>Locatário (Cliente)</th>
        <th>Carro</th>
        <th class="text-center">Data Início</th>
        <th class="text-center">Data Fim</th>
        <th class="text-center">Valor Total</th>
        <th class="text-center">Status</th>
        <th class="text-center">Ações</th>
      </tr>
    </thead>
    
    <tbody>
      <% @emprestimos.each do |emprestimo| %>
        <tr>
          <td class="text-center"><strong><%= emprestimo.id %></strong></td>
          <td><%= emprestimo.locatario&.nome %></td>
          <td><%= emprestimo.carro&.modelo %></td>
          <td class="text-center"><%= emprestimo.data_inicio %></td>
          <td class="text-center"><%= emprestimo.data_fim %></td>
          <td class="text-center">R$ <%= emprestimo.valor_total %></td>
          
          <td class="text-center">
            <span class="badge rounded-pill bg-secondary">
              <%= emprestimo.status %>
            </span>
          </td>
          
          <td>
            <div class="d-flex justify-content-center flex-wrap gap-2">
              
              <% if emprestimo.ativo? %>
                <%= button_to "Finalizar",
                              marcar_emprestimo_como_finalizado_emprestimo_path(emprestimo),
                              method: :patch,
                              class: "btn btn-success btn-sm",
                              data: { confirm: "Confirmar a devolução deste veículo hoje?" } %>
              <% end %>

              <%= link_to 'Mostrar', emprestimo_path(emprestimo), class: 'btn btn-outline-info btn-sm' %>
              <%= link_to 'Editar', edit_emprestimo_path(emprestimo), class: 'btn btn-outline-primary btn-sm' %>

              <%= button_to 'Apagar', emprestimo_path(emprestimo),
                            method: :delete,
                            form: { style: 'margin: 0;' },
                            class: 'btn btn-outline-danger btn-sm',
                            data: { confirm: 'Tem certeza que deseja excluir este empréstimo?' } %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
    
  </table>
</div>
<br>







<nav class="navbar navbar-light mt-5" style="background-color: #e9ecef; border-top: 1px solid #ddd; padding: 15px 0;">
  <div class="container-fluid justify-content-center">
    
    <ul class="nav"> 
      
      <li class="nav-item">
        <%= link_to 'Novo Empréstimo',new_emprestimo_path, class: 'nav-link', style: 'border: 1px solid #ced4da; border-radius: 1px; margin: 0 1px; color: #495057;' %>
      </li>
      
      <li class="nav-item">
        <%= link_to 'Baixar Relatório (PDF)',  emprestimos_path(format: :pdf), class: 'nav-link', style: 'border: 1px solid #ced4da; border-radius: 1px; margin: 0 1px; color: #495057;' %>
      </li>
      
      <li class="nav-item">
        <%= link_to 'Exportar Dados (CSV)', emprestimos_path(format: :csv), class: 'nav-link', style: 'border: 1px solid #ced4da; border-radius: 1px; margin: 0 1px; color: #495057;' %>
      </li>
      
       <%= button_to 'Apagar Todos os Registros', destroy_all_emprestimos_path,
          method: :delete,
          form: { style: 'margin: 0;' },
          class: 'nav-link text-danger',
          style: 'border: 1px solid #ced4da; border-radius: 1px; margin: 0 1px; background: transparent;',
          data: { turbo_confirm: 'CUIDADO! Tem certeza absoluta que deseja apagar TODOS os carros do sistema?' } %>
</li>






       <li class="nav-item">
        <%= link_to 'Início', root_path, class: 'nav-link', style: 'border: 1px solid #ced4da; border-radius: 5px; margin: 0 5px; color: #495057;' %>
      </li>


    </ul>

  </div>
</nav>
<%- model_class = Carro -%>
<div class="page-header">
  <h1><%=t '.title', :default => model_class.model_name.human.titleize %></h1>
</div>

<dl class="row">
  <dt class="col-sm-2"><%= model_class.human_attribute_name(:modelo) %>:</dt>
  <dd class="col-sm-10"><%= @carro.modelo %></dd>
  <dt class="col-sm-2"><%= model_class.human_attribute_name(:marca) %>:</dt>
  <dd class="col-sm-10"><%= @carro.marca %></dd>
  <dt class="col-sm-2"><%= model_class.human_attribute_name(:placa) %>:</dt>
  <dd class="col-sm-10"><%= @carro.placa %></dd>
  <dt class="col-sm-2"><%= model_class.human_attribute_name(:ano) %>:</dt>
  <dd class="col-sm-10"><%= @carro.ano %></dd>
  <dt class="col-sm-2"><%= model_class.human_attribute_name(:cor) %>:</dt>
  <dd class="col-sm-10"><%= @carro.cor %></dd>
</dl>

<div style="display: flex; gap: 5px;">
  <%= link_to 'Voltar', carros_path, class: 'btn btn-default'  %>
  <%= link_to 'Editar', edit_carro_path(@carro), class: 'btn btn-primary' %>

  <%= button_to 'Apagar', carro_path(@carro),
                method: :delete,
                class: 'btn btn-danger',
                onclick: "return confirm('Tem certeza que deseja excluir este carro?');" %>
</div>

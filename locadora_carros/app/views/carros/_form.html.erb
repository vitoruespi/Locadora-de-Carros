<%= form_for @carro, :html => { :class => "carro" } do |f| %>

  <% if @carro.errors.any? %>
    <div class="alert alert-danger">
      <h5 class="alert-heading"><%= pluralize(@carro.errors.count, "error") %> prohibited this carro from being saved:</h5>
      <hr>
      <ul class="mb-0">
      <% @carro.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :modelo, :class => 'form-label' %>
    <%= f.text_field :modelo, :class => 'form-control' %>
    <%=f.error_span(:modelo) %>
  </div>
  <div class="mb-3">
    <%= f.label :marca, :class => 'form-label' %>
    <%= f.text_field :marca, :class => 'form-control' %>
    <%=f.error_span(:marca) %>
  </div>
  <div class="mb-3">
    <%= f.label :placa, :class => 'form-label' %>
    <%= f.text_field :placa, :class => 'form-control' %>
    <%=f.error_span(:placa) %>
  </div>
  <div class="mb-3">
    <%= f.label :ano, :class => 'form-label' %>
    <%= f.text_field :ano, :class => 'form-control' %>
    <%=f.error_span(:ano) %>
  </div>
  <div class="mb-3">
    <%= f.label :cor, :class => 'form-label' %>
    <%= f.text_field :cor, :class => 'form-control' %>
    <%=f.error_span(:cor) %>
  </div>

  <div class="mb-3">
    <%= f.submit nil, :class => 'btn btn-primary' %>
    <%= link_to t('.cancel', :default => t("helpers.links.cancel")),
              carros_path, :class => 'btn btn-secondary' %>
  </div>

<% end %>

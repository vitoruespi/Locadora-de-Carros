<div class="page-header">
  <h1>Locatários Cadastrados</h1>
</div>

<div class="table-responsive shadow-sm" style="border-radius: 8px; overflow: hidden; border: 1px solid #ccc;">
  <table class="table table-striped table-bordered table-hover align-middle mb-0" style="background-color: #fafafa; border-color: #d6d6d6;">
    
    <thead class="table-dark">
      <tr>
        <th class="text-center">CPF</th>
        <th>Nome</th>
        <th class="text-center">Telefone</th>
        <th class="text-center">Idade</th>
        <th class="text-center">Ações</th>
      </tr>
    </thead>
    
    <tbody>
      <% @locatarios.each do |locatario| %>
        <tr>
          <td class="text-center"><strong><%= locatario.cpf %></strong></td>
          <td><%= locatario.nome %></td>
          <td class="text-center"><%= locatario.telefone %></td>
          <td class="text-center"><%= locatario.idade %></td>
          
          <td>
            <div class="d-flex justify-content-center gap-2">
              <%= link_to 'Mostrar', locatario_path(locatario), class: 'btn btn-outline-info btn-sm' %>
              <%= link_to 'Editar', edit_locatario_path(locatario), class: 'btn btn-outline-primary btn-sm' %>

              <%= button_to 'Apagar', locatario_path(locatario),
                            method: :delete,
                            form: { style: 'margin: 0;' },
                            class: 'btn btn-outline-danger btn-sm',
                            data: { turbo_confirm: 'Tem certeza que deseja excluir este locatário?' } %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
    
  </table>
</div>

<br>

<div class="text-center">
  <%= paginate @locatarios %>
</div>




<nav class="navbar navbar-light mt-5" style="background-color: #e9ecef; border-top: 1px solid #ddd; padding: 15px 0;">
  <div class="container-fluid justify-content-center">
    
    <ul class="nav"> 
      
      <li class="nav-item">
        <%= link_to 'Novo Locatário', new_locatario_path, class: 'nav-link', style: 'border: 1px solid #ced4da; border-radius: 1px; margin: 0 1px; color: #495057;' %>
      </li>
      
      <li class="nav-item">
        <%= link_to 'Baixar Relatório (PDF)',  locatarios_path(format: :pdf), class: 'nav-link', style: 'border: 1px solid #ced4da; border-radius: 1px; margin: 0 1px; color: #495057;' %>
      </li>
      
      <li class="nav-item">
        <%= link_to 'Exportar Dados (CSV)', locatarios_path(format: :csv), class: 'nav-link', style: 'border: 1px solid #ced4da; border-radius: 1px; margin: 0 1px; color: #495057;' %>
      </li>
      
 <li class="nav-item d-flex align-items-center">
  <%= button_to 'Apagar Todos os Registros', destroy_all_locatarios_path,
          method: :delete,
          form: { style: 'margin: 0;' },
          class: 'nav-link text-danger',
          style: 'border: 1px solid #ced4da; border-radius: 1px; margin: 0 1px; background: transparent;',
          data: { turbo_confirm: 'CUIDADO! Tem certeza absoluta que deseja apagar TODOS os locatários do sistema?' } %>
</li>

      <li class="nav-item">
        <%= link_to 'Início', root_path, class: 'nav-link', style: 'border: 1px solid #ced4da; border-radius: 5px; margin: 0 5px; color: #495057;' %>
      </li>


    </ul>

  </div>
</nav>